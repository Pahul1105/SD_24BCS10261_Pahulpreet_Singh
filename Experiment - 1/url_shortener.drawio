<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="24.7.17" type="device" compressed="false">
  <diagram id="fr-pipeline-clean" name="01 - Functional Requirements">
    <mxGraphModel dx="1200" dy="500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="430" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="fr-title" value="URL Shortener — Functional Execution Pipeline" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1120" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="fr-sub" value="End-to-end request lifecycle mapping FR-1 through FR-6 to system guarantees." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="57" width="1120" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="fr-h1" value="&lt;b&gt;PIPELINE EXECUTION STAGES&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="node-1" value="&lt;b&gt;Client / Consumer&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;Sends POST /v1/urls or&lt;br/&gt;GET /{shortCode}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="130" width="200" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="node-2" value="&lt;b&gt;[FR-1 &amp; FR-6] Ingress&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Validate URL (&amp;lt;2k chars)&lt;br/&gt;• Enforce rate limits" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="270" y="130" width="200" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="node-3" value="&lt;b&gt;[FR-5] Idempotency&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Check Idempotency-Key&lt;br/&gt;• Deduplicate retries" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="500" y="130" width="200" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="node-4" value="&lt;b&gt;[FR-2] Allocation&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Generate Base62 code&lt;br/&gt;• Resolve collisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="730" y="130" width="200" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="node-5" value="&lt;b&gt;[FR-3 &amp; FR-4] Resolve&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Store / Lookup key&lt;br/&gt;• Return 302 or 404/410" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="960" y="130" width="200" height="115" as="geometry"/>
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endSize=6;" edge="1" parent="1" source="node-1" target="node-2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endSize=6;" edge="1" parent="1" source="node-2" target="node-3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endSize=6;" edge="1" parent="1" source="node-3" target="node-4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endSize=6;" edge="1" parent="1" source="node-4" target="node-5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="fr-h2" value="&lt;b&gt;GOVERNING SYSTEM GUARANTEES&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="275" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="inv-1" value="&lt;b&gt;Guarantee 1: Uniqueness&lt;/b&gt;&lt;br/&gt;Each short code maps strictly to one target URL." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="inv-2" value="&lt;b&gt;Guarantee 2: Read-After-Write&lt;/b&gt;&lt;br/&gt;Immediate GET request resolves right after POST 201." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="305" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="inv-3" value="&lt;b&gt;Guarantee 3: Non-Predictability&lt;/b&gt;&lt;br/&gt;Short codes are opaque with no sequential leak." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#CBD5E1;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="305" width="360" height="85" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="24.7.17" type="device" compressed="false">
  <diagram id="nfr-page-v2" name="02 - Non-Functional Requirements">
    <mxGraphModel dx="1200" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="530" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="nfr-title" value="URL Shortener — Non-Functional Requirements &amp; SLAs" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1120" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="nfr-sub" value="System quality attributes, scale expectations, and latency Service Level Agreements." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="57" width="1120" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="nfr-h1" value="&lt;b&gt;NON-FUNCTIONAL SYSTEM REQUIREMENTS&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="nfr-1" value="&lt;b&gt;[NFR-1] High Availability &amp; Fault Tolerance&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Target 99.99% uptime (max ~52 mins downtime/year).&lt;br/&gt;• Multi-region active-passive fallback for read cache.&lt;br/&gt;• Graceful degradation during database partition." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="125" width="545" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="nfr-2" value="&lt;b&gt;[NFR-2] Ultra-Low Latency&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Redirection (Read): p99 &amp;lt; 10ms via distributed in-memory cache.&lt;br/&gt;• Creation (Write): p99 &amp;lt; 50ms including Base62 generation.&lt;br/&gt;• Cache hit ratio goal &amp;gt; 95% for hot key lookups." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="615" y="125" width="545" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="nfr-3" value="&lt;b&gt;[NFR-3] Scalability &amp; High Throughput&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Support 10:1 Read-to-Write traffic ratio.&lt;br/&gt;• Horizontal scaling for stateless API application nodes.&lt;br/&gt;• DB sharding strategies based on short-code hash." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="260" width="545" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="nfr-4" value="&lt;b&gt;[NFR-4] Security &amp; Data Durability&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Enforce TLS 1.3 encryption in transit &amp;amp; AES-256 at rest.&lt;br/&gt;• Rate limiting to defend against DDOS &amp;amp; crawler enumeration.&lt;br/&gt;• Persistent store backup with 10-year retention guarantee." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="615" y="260" width="545" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="nfr-h2" value="&lt;b&gt;TARGET SCALE METRICS &amp; CAPACITY SLAs&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="kpi-1" value="&lt;b&gt;&lt;font size=&quot;3&quot;&gt;10,000 QPS&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;Peak Read Redirection Throughput&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1.5;fontColor=#0F172A;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="265" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="kpi-2" value="&lt;b&gt;&lt;font size=&quot;3&quot;&gt;1,000 QPS&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;Peak Write Creation Throughput&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1.5;fontColor=#0F172A;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="325" y="425" width="265" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="kpi-3" value="&lt;b&gt;&lt;font size=&quot;3&quot;&gt;~3.6 TB / Year&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;Estimated Datastore Growth Rate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1.5;fontColor=#0F172A;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="610" y="425" width="265" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="kpi-4" value="&lt;b&gt;&lt;font size=&quot;3&quot;&gt;&amp;lt; 10 ms (p99)&lt;/font&gt;&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#475569&quot;&gt;Target Redirection Latency&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#E2E8F0;strokeWidth=1.5;fontColor=#0F172A;spacing=8;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="895" y="425" width="265" height="85" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="24.7.17" type="device" compressed="false">
  <diagram id="hld-flowchart-v4" name="03 - Architecture Flowchart">
    <mxGraphModel dx="1200" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="530" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="hld-title" value="URL Shortener — High-Level System Architecture &amp; Request Flow" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1120" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="hld-sub" value="End-to-end operational flowchart detailing request routing, key generation, cache-aside lookups, and asynchronous event streams." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="57" width="1120" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="hld-h1" value="&lt;b&gt;STEP-BY-STEP REQUEST FLOWCHART&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="95" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="comp-client" value="&lt;b&gt;1. Client Tier&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Web Browsers&lt;br/&gt;• Mobile Apps&lt;br/&gt;• REST API Clients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#7C3AED;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
        <mxGeometry x="220" y="130" width="170" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="comp-app" value="&lt;b&gt;3. URL App Service&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Stateless App Nodes&lt;br/&gt;• Base62 Encoding&lt;br/&gt;• Cache/DB Orchestration" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="130" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="comp-kgs" value="&lt;b&gt;Key Generation (KGS)&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Pre-computes Base62 keys&lt;br/&gt;• In-memory key buffers&lt;br/&gt;• Zero DB write latency" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#D97706;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="260" width="210" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="comp-cache" value="&lt;b&gt;4a. Redis Cache Cluster&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• In-memory lookups&lt;br/&gt;• LRU Eviction Policy&lt;br/&gt;• Target &amp;gt;95% Hit Ratio" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="660" y="130" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="comp-db" value="&lt;b&gt;4b. Distributed DB&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• NoSQL (Cassandra/Dynamo)&lt;br/&gt;• Sharded by short_code&lt;br/&gt;• Persistent storage" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="660" y="260" width="200" height="110" as="geometry"/>
        </mxCell>
        <mxCell id="comp-async" value="&lt;b&gt;5. Async Analytics Pipeline&lt;/b&gt;&lt;br/&gt;&lt;br/&gt;• Kafka Click Event Stream&lt;br/&gt;• Real-time Metrics Processing&lt;br/&gt;• Data Lake / OLAP Store" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5F3FF;strokeColor=#6366F1;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="890" y="130" width="270" height="240" as="geometry"/>
        </mxCell>
        <mxCell id="edge-1" value="HTTP Request" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endSize=6;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="comp-client" target="comp-gw">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-2" value="Route" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.5;endArrow=classic;endSize=6;fontSize=10;fontColor=#475569;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="comp-gw" target="comp-app">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-3" value="Fetch Key" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;endArrow=classic;endSize=6;fontSize=10;fontColor=#D97706;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="comp-app" target="comp-kgs">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-4" value="Cache Check (&lt;10ms)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;endSize=6;fontSize=10;fontColor=#059669;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="comp-app" target="comp-cache">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-5" value="Cache Miss / Persist" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;endArrow=classic;endSize=6;fontSize=10;fontColor=#059669;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="comp-cache" target="comp-db">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="edge-6" value="Emit Telemetry" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#6366F1;strokeWidth=1.5;endArrow=classic;endSize=6;fontSize=10;fontColor=#6366F1;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="comp-cache" target="comp-async">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="880" y="185"/></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="hld-h2" value="&lt;b&gt;KEY ARCHITECTURAL PATTERNS &amp; DATA FLOWS&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="395" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="pat-1" value="&lt;b&gt;Cache-Aside Redirection&lt;/b&gt;&lt;br/&gt;Read traffic checks Redis first (&lt;10ms). Cache misses query NoSQL DB and asynchronously backfill Redis." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="425" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="pat-2" value="&lt;b&gt;Pre-Generated Keys (KGS)&lt;/b&gt;&lt;br/&gt;Dedicated service generates unique Base62 strings offline, eliminating DB locks and collision checks during writes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="420" y="425" width="360" height="85" as="geometry"/>
        </mxCell>
        <mxCell id="pat-3" value="&lt;b&gt;Asynchronous Click Analytics&lt;/b&gt;&lt;br/&gt;Redirection writes click telemetry to Kafka topics asynchronously, keeping read paths completely unblocked." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#CBD5E1;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=10;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="800" y="425" width="360" height="85" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="Electron" version="24.7.17" type="device" compressed="false">
  <diagram id="api-estimation-v5" name="04-05 - API Design &amp; Estimations">
    <mxGraphModel dx="1200" dy="550" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="530" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="URL Shortener — API Design &amp; Scale Estimation" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=20;fontStyle=1;fontColor=#0F172A;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1120" height="32" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="RESTful endpoint specifications, payload contracts, and back-of-the-envelope capacity projections." style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontSize=13;fontColor=#475569;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="52" width="1120" height="22" as="geometry"/>
        </mxCell>
        <mxCell id="sec1-h" value="&lt;b&gt;4. RESTFUL API DESIGN CONTRACTS&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="api-1" value="&lt;b&gt;Create Short URL&lt;/b&gt;&lt;br/&gt;&lt;i&gt;POST /api/v1/urls&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Request Body:&lt;/b&gt; long_url, custom_alias, expires_at&lt;br/&gt;• &lt;b&gt;Response (201 Created):&lt;/b&gt;&lt;br/&gt;   Returns short_code, short_url, timestamps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="115" width="360" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="api-2" value="&lt;b&gt;Redirect to Original URL&lt;/b&gt;&lt;br/&gt;&lt;i&gt;GET /{short_code}&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Parameters:&lt;/b&gt; short_code (Path)&lt;br/&gt;• &lt;b&gt;Response (302 Found):&lt;/b&gt;&lt;br/&gt;   Redirects via Location header to long_url&lt;br/&gt;• &lt;b&gt;Fallback:&lt;/b&gt; 404 Not Found if expired" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="115" width="360" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="api-3" value="&lt;b&gt;Retrieve Click Analytics&lt;/b&gt;&lt;br/&gt;&lt;i&gt;GET /api/v1/urls/{short_code}/analytics&lt;/i&gt;&lt;br/&gt;&lt;br/&gt;• &lt;b&gt;Parameters:&lt;/b&gt; short_code (Path)&lt;br/&gt;• &lt;b&gt;Response (200 OK):&lt;/b&gt;&lt;br/&gt;   total_clicks, unique_visitors, top_countries breakdown" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="115" width="360" height="195" as="geometry"/>
        </mxCell>
        <mxCell id="sec2-h" value="&lt;b&gt;5. BACK-OF-THE-ENVELOPE SCALE ESTIMATION&lt;/b&gt;" style="whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;fontColor=#1E3A8A;fontSize=12;align=left;" vertex="1" parent="1">
          <mxGeometry x="40" y="325" width="1120" height="25" as="geometry"/>
        </mxCell>
        <mxCell id="est-1" value="&lt;b&gt;Traffic Throughput (RPS)&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Writes:&lt;/b&gt; ~200 RPS (Peak 400 writes/sec)&lt;br/&gt;• &lt;b&gt;Reads:&lt;/b&gt; ~19,290 RPS (Peak ~38,580 reads/sec at 100:1 read-write ratio)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="40" y="355" width="360" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="est-2" value="&lt;b&gt;5-Year Storage Capacity&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Total Records:&lt;/b&gt; 30 billion entries&lt;br/&gt;• &lt;b&gt;Raw Storage:&lt;/b&gt; ~15 TB (500 bytes/record)&lt;br/&gt;• &lt;b&gt;Cluster Storage:&lt;/b&gt; ~45 TB with 3x NoSQL replication factor" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="355" width="360" height="135" as="geometry"/>
        </mxCell>
        <mxCell id="est-3" value="&lt;b&gt;Redis Cache Memory Sizing&lt;/b&gt;&lt;br/&gt;• &lt;b&gt;Daily Read Volume:&lt;/b&gt; ~1.73 billion reads&lt;br/&gt;• &lt;b&gt;Hot Data (20%):&lt;/b&gt; 346 million records&lt;br/&gt;• &lt;b&gt;RAM Required:&lt;/b&gt; ~173 GB for high-hit redirection cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;fontColor=#0F172A;fontSize=11;spacing=8;align=left;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="355" width="360" height="135" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
