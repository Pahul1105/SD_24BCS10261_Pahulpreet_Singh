        <mxCell id="reqTitle" value="NETFLIX - FUNCTIONAL &amp; NON-FUNCTIONAL REQUIREMENTS" style="text;html=1;strokeColor=none;fillColor=none;fontSize=26;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="30" width="900" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="functionalReq" value="FUNCTIONAL REQUIREMENTS&#xa;&#xa;F1 - Register, Login and Manage Profiles&#xa;&#xa;F2 - Browse Movies and Series&#xa;&#xa;F3 - Search Titles and Episodes&#xa;&#xa;F4 - View Title Details&#xa;&#xa;F5 - Play, Pause and Seek Video&#xa;&#xa;F6 - Adaptive Video Quality&#xa;&#xa;F7 - Check Subscription Before Playback&#xa;&#xa;F8 - Save and Resume Watch Progress&#xa;&#xa;F9 - Add / Remove My List&#xa;&#xa;F10 - Admin Upload and Publish Content&#xa;&#xa;F11 - Encode Videos into Multiple Qualities" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="100" y="120" width="650" height="680" as="geometry"/>
        </mxCell>

        <mxCell id="nonFunctionalReq" value="NON-FUNCTIONAL REQUIREMENTS&#xa;&#xa;Availability: 99.9% monthly&#xa;&#xa;API Latency: 95% requests below 300 ms&#xa;&#xa;Playback Startup: 95% within 3 seconds&#xa;&#xa;Scalability: 20,000 peak concurrent viewers&#xa;&#xa;Security: HTTPS + Authentication + Authorization&#xa;&#xa;Password Protection: Secure Password Hashing&#xa;&#xa;Durability: Backups + Redundant Storage&#xa;&#xa;Reliability: Failed Encoding Jobs Can Retry&#xa;&#xa;Performance: CDN for Video Delivery&#xa;&#xa;Consistency: Subscription Checked from PostgreSQL&#xa;&#xa;Usability: Captions + Accessible Controls" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="850" y="120" width="650" height="680" as="geometry"/>
        </mxCell>

        <mxCell id="outOfScope" value="OUT OF SCOPE: Live Streaming • Offline Downloads • Advertising • Social Features • ML Recommendations • Global Active-Active Deployment • Payment Gateway Implementation • Full Commercial DRM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="100" y="850" width="1400" height="90" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================== -->
  <!-- PAGE 3 - BACK OF ENVELOPE -->
  <!-- ===================================================== -->
  <diagram id="estimates" name="03 - Back of the Envelope Estimation">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="estimateTitle" value="NETFLIX - BACK-OF-THE-ENVELOPE ESTIMATION" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="30" width="800" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="assumptions" value="1. ASSUMPTIONS&#xa;&#xa;Registered Accounts = 1,000,000&#xa;Profiles = 2,000,000&#xa;Daily Active Users = 100,000&#xa;Watch Time = 2 hours/user/day&#xa;Peak Concurrent Users = 20,000&#xa;Average Video Bitrate = 5 Mbps&#xa;Browse/Search Requests = 40/user/day&#xa;Catalog = 10,000 videos&#xa;Average Video Duration = 1 hour" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="460" height="400" as="geometry"/>
        </mxCell>

        <mxCell id="apiTraffic" value="2. API TRAFFIC&#xa;&#xa;Browse/Search per day&#xa;100,000 × 40 = 4,000,000&#xa;&#xa;Average RPS&#xa;4,000,000 / 86,400 ≈ 46 RPS&#xa;&#xa;Peak RPS&#xa;46 × 5 ≈ 230 RPS&#xa;&#xa;Progress Updates&#xa;≈ 333 peak writes/sec&#xa;&#xa;Combined Peak ≈ 570 RPS&#xa;&#xa;Capacity Target ≈ 1,000 - 1,200 RPS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="120" width="460" height="400" as="geometry"/>
        </mxCell>

        <mxCell id="bandwidth" value="3. VIDEO BANDWIDTH&#xa;&#xa;Average Concurrent Viewers&#xa;100,000 × 2 / 24 ≈ 8,333&#xa;&#xa;Average Bandwidth&#xa;8,333 × 5 Mbps ≈ 41.7 Gbps&#xa;&#xa;Peak Bandwidth&#xa;20,000 × 5 Mbps = 100 Gbps&#xa;&#xa;Daily Video Transfer&#xa;≈ 450 TB/day&#xa;&#xa;95% CDN Hit Ratio&#xa;Origin Traffic ≈ 22.5 TB/day" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="120" width="460" height="400" as="geometry"/>
        </mxCell>

        <mxCell id="storage" value="4. VIDEO STORAGE&#xa;&#xa;Encoded Versions&#xa;≈ 5.4 GB per 1 hour video&#xa;&#xa;10,000 × 5.4 GB&#xa;≈ 54 TB encoded library&#xa;&#xa;Original Uploads&#xa;≈ 22.5 GB per video&#xa;&#xa;10,000 × 22.5 GB&#xa;≈ 225 TB originals&#xa;&#xa;TOTAL LOGICAL STORAGE&#xa;≈ 279 TB&#xa;&#xa;Before redundancy, backups and future growth" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="560" width="460" height="360" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

