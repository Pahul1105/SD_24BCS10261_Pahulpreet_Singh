        <mxCell id="b7" value="Store in Cache" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="browseSQL" target="browseRedis">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
