              <mxPoint x="770" y="265"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="b8" value="Return Results" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="browseBackend" target="browseResponse">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="640" y="340"/>
              <mxPoint x="1250" y="340"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================== -->
  <!-- PAGE 6 - PLAYBACK FLOW -->
  <!-- ===================================================== -->
  <diagram id="playback-flow" name="06 - Playback and Streaming Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="playTitle" value="NETFLIX - PLAYBACK &amp; STREAMING FLOW" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="450" y="30" width="700" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="playUser" value="USER / PLAYER&#xa;&#xa;Press PLAY" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="400" width="180" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="playLB" value="LOAD BALANCER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="280" y="415" width="180" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="playBackend" value="BACKEND SERVER&#xa;&#xa;Authentication&#xa;Profile Ownership&#xa;Subscription Check&#xa;Availability Check&#xa;Title READY Check" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="510" y="355" width="260" height="210" as="geometry"/>
        </mxCell>

        <mxCell id="playSQL" value="POSTGRESQL&#xa;&#xa;Subscription&#xa;Availability&#xa;Watch Progress" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="160" width="230" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="playGrant" value="PLAYBACK GRANT&#xa;&#xa;Manifest URL&#xa;Short-lived Token&#xa;Resume Position&#xa;Expiry" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="850" y="500" width="230" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="playCDN" value="CDN&#xa;&#xa;Manifest&#xa;Video Segments&#xa;Adaptive Bitrate&#xa;Cache" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="350" width="230" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="playStorage" value="OBJECT STORAGE&#xa;&#xa;Encoded Video&#xa;HLS Segments&#xa;Manifest" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1150" y="600" width="230" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="p1" value="POST /playback" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="playUser" target="playLB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="playLB" target="playBackend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p3" value="Access Check" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="playBackend" target="playSQL">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="790" y="460"/>
              <mxPoint x="790" y="245"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p4" value="Allowed" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="playSQL" target="playGrant">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1000" y="400"/>
              <mxPoint x="965" y="400"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p5" value="Manifest + Token" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="playGrant" target="playCDN">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p6" value="Cache Miss" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="playCDN" target="playStorage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="p7" value="Video Segments" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="playCDN" target="playUser">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1265" y="270"/>
              <mxPoint x="140" y="270"/>
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="playNote" value="IMPORTANT: Backend authorizes playback. CDN delivers the large video files directly to users." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#EA580C;strokeWidth=2;fontSize=16;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="375" y="850" width="850" height="70" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================== -->
  <!-- PAGE 7 - ADMIN UPLOAD -->
  <!-- ===================================================== -->
  <diagram id="upload-flow" name="07 - Admin Upload and Encoding Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="uploadTitle" value="NETFLIX - ADMIN UPLOAD &amp; ENCODING FLOW" style="text;html=1;strokeColor=none;fillColor=none;fontSize=27;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="420" y="30" width="760" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="admin" value="AUTHORIZED ADMIN" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#DC2626;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="190" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="uploadBackend" value="BACKEND API&#xa;&#xa;Admin Authentication&#xa;Create Draft&#xa;Generate Upload URL" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="385" width="230" height="170" as="geometry"/>
        </mxCell>

        <mxCell id="originalStorage" value="OBJECT STORAGE&#xa;&#xa;Original Video Upload" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#EDE9FE;strokeColor=#7C3AED;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="200" width="230" height="150" as="geometry"/>
        </mxCell>

        <mxCell id="encodingJob" value="ENCODING JOB&#xa;&#xa;PENDING&#xa;PROCESSING&#xa;COMPLETED&#xa;FAILED" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="600" y="550" width="230" height="160" as="geometry"/>
        </mxCell>

        <mxCell id="worker" value="VIDEO ENCODING WORKER&#xa;&#xa;Claim Job&#xa;Validate Video&#xa;Transcode&#xa;Generate HLS&#xa;Create Segments" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="370" width="240" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="encodedStorage" value="ENCODED OUTPUT&#xa;&#xa;360p&#xa;480p&#xa;720p&#xa;1080p&#xa;HLS Manifest" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#CFFAFE;strokeColor=#0891B2;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1250" y="370" width="220" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="ready" value="TITLE STATUS = READY&#xa;&#xa;Invalidate Catalog Cache&#xa;Content Available for Playback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="650" width="330" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="u1" value="Request Upload URL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="admin" target="uploadBackend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="u2" value="Upload Video" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="admin" target="originalStorage">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="145" y="275"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="u3" value="Create Job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="uploadBackend" target="encodingJob">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="415" y="630"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="u4" value="Claim Job" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="encodingJob" target="worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="630"/>
              <mxPoint x="860" y="520"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="u5" value="Read Original" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="originalStorage" target="worker">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="860" y="275"/>
              <mxPoint x="860" y="420"/>
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="u6" value="Encoded Output" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="worker" target="encodedStorage">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="u7" value="Publish" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="worker" target="ready">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <!-- ===================================================== -->
  <!-- PAGE 8 - WATCH PROGRESS -->
  <!-- ===================================================== -->
  <diagram id="progress-flow" name="08 - Watch Progress and Resume Flow">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="progressTitle" value="NETFLIX - WATCH PROGRESS &amp; RESUME FLOW" style="text;html=1;strokeColor=none;fillColor=none;fontSize=28;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="40" width="800" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="progressUser" value="USER WATCHING VIDEO&#xa;&#xa;positionSeconds = 1260" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="390" width="230" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="progressTimer" value="SAVE PROGRESS&#xa;&#xa;Every 60 Seconds&#xa;Also on Pause / Exit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="360" y="390" width="220" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="progressLB" value="LOAD BALANCER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#6B7280;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="640" y="410" width="190" height="90" as="geometry"/>
        </mxCell>

        <mxCell id="progressBackend" value="BACKEND SERVER&#xa;&#xa;Validate User&#xa;Validate Profile&#xa;Validate Title&#xa;Validate Position" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="360" width="230" height="190" as="geometry"/>
        </mxCell>

        <mxCell id="progressSQL" value="POSTGRESQL&#xa;&#xa;watch_progress&#xa;&#xa;profile_id&#xa;title_id&#xa;position_seconds&#xa;updated_at" style="shape=cylinder;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1200" y="355" width="230" height="200" as="geometry"/>
        </mxCell>

        <mxCell id="resume" value="RESUME ON ANOTHER DEVICE&#xa;&#xa;Read Latest Position&#xa;Continue Watching" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E8FF;strokeColor=#9333EA;strokeWidth=2;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="900" y="650" width="300" height="130" as="geometry"/>
        </mxCell>

        <mxCell id="w1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="progressUser" target="progressTimer">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w2" value="PUT /progress" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="progressTimer" target="progressLB">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="progressLB" target="progressBackend">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w4" value="UPSERT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="progressBackend" target="progressSQL">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="w5" value="Latest Position" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="progressSQL" target="resume">
          <mxGeometry relative="1" as="geometry">
             <Array as="points">
              <mxPoint x="1315" y="715"/>
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
