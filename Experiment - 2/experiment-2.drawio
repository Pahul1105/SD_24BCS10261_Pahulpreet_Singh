        <mxCell id="b4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="browseRedis" target="cacheDecision">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b5" value="MISS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="cacheDecision" target="browseSQL">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="b6" value="HIT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;strokeWidth=2;" edge="1" parent="1" source="cacheDecision" target="browseResponse">
          <mxGeometry relative="1" as="geometry"/>
