  <diagram id="requirements" name="02 - Functional and Non-Functional Requirements">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" page="1" pageWidth="1600" pageHeight="1000">
      <root>
        <mxCell id="0"/>
